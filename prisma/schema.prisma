generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PasswordRecoveryStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  sector       String
  phone        String?    @unique
  cpfHash      String     @unique
  cpfCiphertext String?
  passwordHash String
  passwordCiphertext String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions Session[]
  openedTickets   Ticket[] @relation("TicketOpenedBy")
  assignedTickets Ticket[] @relation("TicketAssignedTo")
  resolvedTickets Ticket[] @relation("TicketResolvedBy")
  uploadFiles     UploadFile[]
  presence        UserPresence?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AccessRequest {
  id            String              @id @default(cuid())
  name          String
  email         String
  sector        String
  phone         String
  cpfHash       String
  cpfCiphertext String
  cpfLast4      String
  status        AccessRequestStatus @default(PENDING)
  acceptedTerms Boolean             @default(true)
  approvedAt    DateTime?
  rejectedAt    DateTime?
  handledById   String?
  createdUserId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([cpfHash])
  @@index([phone])
  @@map("access_requests")
}

model PasswordRecoveryRequest {
  id         String                 @id @default(cuid())
  username   String
  email      String
  sector     String
  whatsapp   String
  status     PasswordRecoveryStatus @default(PENDING)
  resolvedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("password_recovery_requests")
}

model Ticket {
  id           String       @id @default(cuid())
  title        String
  description  String?
  sector       String
  status       TicketStatus @default(OPEN)
  openedById   String
  assignedToId String?
  resolvedById String?
  assignedAt   DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  openedBy   User  @relation("TicketOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  assignedTo User? @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("TicketResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([openedById, createdAt])
  @@index([sector, status, createdAt])
  @@index([assignedToId, status, assignedAt])
  @@index([resolvedById, resolvedAt])
  @@map("tickets")
}

model AppStateDocument {
  key       String   @id
  data      Json     @default("{}")
  revision  BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_state_documents")
}

model RealtimeEvent {
  id        BigInt   @id @default(autoincrement())
  clientId  String?  @map("client_id")
  source    String   @default("system")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "realtime_events_created_at_idx")
  @@map("realtime_events")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  actorEmail String?  @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  summary    String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@index([actorId, createdAt], map: "audit_logs_actor_created_at_idx")
  @@index([entityType, entityId, createdAt], map: "audit_logs_entity_created_at_idx")
  @@map("audit_logs")
}

model ServiceTicketRecord {
  id                String    @id
  title             String
  description       String
  requesterId       String    @map("requester_id")
  requesterName     String    @map("requester_name")
  requesterSector   String    @map("requester_sector")
  targetSector      String    @map("target_sector")
  priority          String
  status            String
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  lastInteractionAt DateTime  @map("last_interaction_at")
  assignedToId      String?   @map("assigned_to_id")
  assignedToName    String?   @map("assigned_to_name")
  assignedToSector  String?   @map("assigned_to_sector")
  closedAt          DateTime? @map("closed_at")
  closedById        String?   @map("closed_by_id")
  closedByName      String?   @map("closed_by_name")
  closeDescription  String?   @map("close_description")
  reopenedAt        DateTime? @map("reopened_at")
  reopenedById      String?   @map("reopened_by_id")
  reopenedByName    String?   @map("reopened_by_name")
  reopenReason      String?   @map("reopen_reason")

  attachments ServiceTicketAttachmentRecord[]
  messages    ServiceTicketMessageRecord[]
  transfers   ServiceTicketTransferRecord[]

  @@index([status, targetSector, lastInteractionAt], map: "service_ticket_records_status_sector_idx")
  @@index([requesterId, createdAt], map: "service_ticket_records_requester_idx")
  @@index([assignedToId, status], map: "service_ticket_records_assignee_idx")
  @@index([closedAt], map: "service_ticket_records_closed_at_idx")
  @@map("service_ticket_records")
}

model ServiceTicketMessageRecord {
  id           String   @id
  ticketId     String   @map("ticket_id")
  authorId     String   @map("author_id")
  authorName   String   @map("author_name")
  authorSector String   @map("author_sector")
  content      String
  createdAt    DateTime @map("created_at")
  isSystem     Boolean  @default(false) @map("is_system")
  isInternal   Boolean  @default(false) @map("is_internal")

  ticket      ServiceTicketRecord             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments ServiceTicketAttachmentRecord[]

  @@index([ticketId, createdAt], map: "service_ticket_messages_ticket_created_idx")
  @@index([authorId, createdAt], map: "service_ticket_messages_author_idx")
  @@map("service_ticket_messages")
}

model ServiceTicketAttachmentRecord {
  id           String  @id
  attachmentId String  @map("attachment_id")
  ticketId     String  @map("ticket_id")
  messageId    String? @map("message_id")
  name         String
  size         Int
  kind         String
  url          String
  extension    String?

  ticket  ServiceTicketRecord         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message ServiceTicketMessageRecord? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "service_ticket_attachments_ticket_idx")
  @@index([messageId], map: "service_ticket_attachments_message_idx")
  @@map("service_ticket_attachments")
}

model ServiceTicketTransferRecord {
  id                String   @id
  ticketId          String   @map("ticket_id")
  createdAt         DateTime @map("created_at")
  fromSector        String   @map("from_sector")
  toSector          String   @map("to_sector")
  transferredById   String   @map("transferred_by_id")
  transferredByName String   @map("transferred_by_name")
  assignedToId      String?  @map("assigned_to_id")
  assignedToName    String?  @map("assigned_to_name")

  ticket ServiceTicketRecord @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt], map: "service_ticket_transfers_ticket_created_idx")
  @@map("service_ticket_transfers")
}

model UploadFile {
  id           String   @id @default(cuid())
  ownerId      String
  originalName String
  storedName   String   @unique
  mimeType     String
  kind         String
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("upload_files")
}

model UserPresence {
  userId              String   @id
  chatStatus          String   @default("offline")
  preferredChatStatus String   @default("online") @map("preferred_chat_status")
  workStatus          String   @default("available")
  lastSeenAt          DateTime?
  updatedAt           DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients UserPresenceClient[]

  @@map("user_presences")
}

model UserPresenceClient {
  id         String   @id
  userId     String
  clientId   String
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  presence UserPresence @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, isActive, lastSeenAt])
  @@map("user_presence_clients")
}
