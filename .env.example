# Copie para .env e ajuste antes de rodar.
# Nunca coloque valores reais de producao neste arquivo.

NODE_ENV="development"
PORT="3000"

# Obrigatorio em qualquer ambiente real. Use pelo menos 32 caracteres.
SESSION_SECRET="troque-por-uma-chave-com-32-caracteres-ou-mais"
# Use "false" apenas quando rodar em producao por HTTP interno sem HTTPS.
# Em producao com HTTPS, mantenha "true" ou remova esta variavel.
SESSION_COOKIE_SECURE="true"

# Producao precisa de PostgreSQL.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/unipar_atendimentos?schema=public"

# Desenvolvimento sem banco.
# Em producao esta flag e bloqueada por padrao pelo codigo.
LOCAL_DATA_ONLY="false"
AUTH_OFFLINE_FALLBACK="false"
LOCAL_AUTH_USER_SEED="false"
LOCAL_AUTH_USER_EMAIL="dev@unipar.br"
LOCAL_AUTH_USER_PASSWORD="12345678"
LOCAL_AUTH_USER_NAME="Dev Local"
LOCAL_AUTH_USER_SECTOR="ti"
LOCAL_AUTH_USER_PHONE="45999999999"
LOCAL_AUTH_USER_CPF="00000000000"

# Emergencia apenas se voce realmente quiser permitir dados locais em producao.
# Mantenha false no servidor oficial.
ALLOW_LOCAL_DATA_IN_PRODUCTION="false"
